DATABASE_URL=sqlite:///./storage/petforge.db
PETFORGE_DATABASE_PATH=./storage/petforge.db
REDIS_URL=
STORAGE_PROVIDER=local
AI_PROVIDER=mock
BACKGROUND_REMOVAL_PROVIDER=rembg
PETFORGE_3D_PROVIDER=triposr
PETFORGE_TRIPOSR_REPO=.tools/TripoSR
# Change cache paths to a disk with enough space if needed.
PETFORGE_TRIPOSR_MODEL=.tools/ai-cache/triposr-model
# scripts/setup-ai.ps1 writes the local TripoSR Python path here.
PETFORGE_TRIPOSR_PYTHON=
PETFORGE_TRIPOSR_TIMEOUT_SECONDS=1200
HF_HOME=.tools/ai-cache/huggingface
REMBG_HOME=.tools/ai-cache/rembg
PETFORGE_GODOT_EXECUTABLE=
PETFORGE_RUNTIME_EXECUTABLE=
PETFORGE_RUNTIME_PROJECT=apps/desktop
