{
  "name": "petforge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"pnpm --filter @petforge/api dev\" \"pnpm --filter @petforge/web dev\"",
    "dev:web": "pnpm --filter @petforge/web dev",
    "dev:api": "pnpm --filter @petforge/api dev",
    "start:web": "pnpm --filter @petforge/web start",
    "typecheck": "pnpm --filter @petforge/pet-schema typecheck && pnpm --filter @petforge/web typecheck",
    "build": "pnpm --filter @petforge/pet-schema build && pnpm --filter @petforge/web build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  }
}
